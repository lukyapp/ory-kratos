{
  "$id": "https://example.com/schemas/default",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Default identity schema",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "recovery": {
              "via": "email"
            },
            "verification": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "title": "Name"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "traits"
  ],
  "additionalProperties": false,
  "credentials": {
    "password": {
      "identifier": [
        "traits.email"
      ]
    }
  }
}
