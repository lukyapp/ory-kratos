version: v25.4.0

dsn: ${DSN}

log:
  level: info
  format: json

cookies:
  domain: ${DOMAIN_COOKIE}
  path: /
  same_site: Lax

serve:
  public:
    base_url: ${KRATOS_PUBLIC_URL}
    host: 0.0.0.0
    port: 4433
    cors:
          enabled: true
          allowed_origins:
            - ${SELF_SERVICE_UI_URL}
          allowed_methods:
            - GET
            - POST
            - PUT
            - PATCH
            - DELETE
          allowed_headers:
            - Authorization
            - Content-Type
            - X-Session-Token
            - X-CSRF-Token
            - Cookie
            - Accept
          exposed_headers:
            - Content-Type
            - Set-Cookie
          allow_credentials: true
  admin:
    host: 0.0.0.0
    port: 4434

secrets:
  cookie:
    - ${COOKIE_SECRET}
  cipher:
    - ${CIPHER_SECRET}

identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/kratos/identity.schema.json

selfservice:
  default_browser_return_url: ${SELF_SERVICE_UI_URL}
  allowed_return_urls:
    - ${SELF_SERVICE_UI_URL}

  methods:
    password:
      enabled: true
    oidc:
      enabled: true
      config:
        providers:
          - id: google
            provider: google
            client_id: ${OIDC_PROVIDERS_GOOGLE_CLIENT_ID}
            client_secret: ${OIDC_PROVIDERS_GOOGLE_CLIENT_SECRET}
            mapper_url: file:///etc/kratos/mappers/google.jsonnet
            scope:
              - email
              - profile

  flows:
    login:
      ui_url: ${SELF_SERVICE_UI_URL}/auth/login
    registration:
      ui_url: ${SELF_SERVICE_UI_URL}/auth/registration
    settings:
      ui_url: ${SELF_SERVICE_UI_URL}/settings
    recovery:
      enabled: true
      ui_url: ${SELF_SERVICE_UI_URL}/auth/recovery
    verification:
      enabled: true
      ui_url: ${SELF_SERVICE_UI_URL}/auth/verification
    error:
      ui_url: ${SELF_SERVICE_UI_URL}/error

#courier:
#  smtp:
#    connection_uri: ${SMTP_URI}

oauth2_provider:
  url: ${OAUTH2_PROVIDER_URL}