# Required
# Default: none, must be set
DSN=postgres://kratos:password@kratos-postgres:5432/kratos?sslmode=disable

# Required
# Default: none, must be set
KRATOS_PUBLIC_URL=http://localhost:4433

# Required
# Default: none, must be set
SELF_SERVICE_UI_URL=http://localhost:3000

# Required
# Default: none, must be set
DEFAULT_SECRET=replace-with-a-long-random-secret

# Required
# Default: none, must be set
COOKIE_SECRET=replace-with-a-long-random-secret

# Required
# Default: none, must be set
CIPHER_SECRET=replace-with-a-long-random-secret

# Required
# Default: none, must be set
PAGINATION_SECRET=replace-with-a-long-random-secret

# Required
# Default: none, must be set
OIDC_PROVIDERS_GOOGLE_CLIENT_ID=replace-me

# Required
# Default: none, must be set
OIDC_PROVIDERS_GOOGLE_CLIENT_SECRET=replace-me

# Required
# Default: none, must be set
DOMAIN_COOKIE=localhost

# Required
# Default: none, must be set
OAUTH2_PROVIDER_URL=http://hydra:4445

# Required
# Local default uses Mailpit from dev/docker-compose.yml
KRATOS_SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true

# Required
# Must use a verified sender domain in production
KRATOS_SMTP_FROM_ADDRESS=no-reply@localhost

# Required
# Display name used by verification and recovery emails
KRATOS_SMTP_FROM_NAME=Verification Code

# Required
# Default: Lax
SESSION_COOKIE_SAME_SITE=Lax

# Optional
# Default: true
RUN_MIGRATIONS=true

# Optional
# Default: --dev
# The entrypoint always adds --watch-courier.
KRATOS_EXTRA_ARGS=--dev
